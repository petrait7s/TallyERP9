     "type": "Donation Receipt",
     "date": "2026-03-04",
     "entries": [
      {
       "ledger": "Cash",
       "amount": 333300
      },
      {
       "ledger": "Local Donations",
       "amount": -333300,
       "costCentres": [
        {
         "costCentre": "Donor: Test Donor",
         "amount": 333300

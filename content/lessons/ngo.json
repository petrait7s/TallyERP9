     "vtype": "Journal",
     "ledgers": [
      "General Fund",
      "Designated Fund - Emergency"
     ],
     "amount": 1234500
    }
   },
   {
    "instruction": {
     "en": "Open Fund-wise Statement.",
     "bn": "Fund-wise Statement খুলুন।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "visited",
     "key": "report:mod:funds.statement"
    }
   },
   {
    "instruction": {
     "en": "Open Fund Statement (Display).",
     "bn": "Fund Statement খুলুন।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "visited",
     "key": "report:funds"
    }
   }
  ],
  "solution": [
   {
    "op": "run",
    "action": "fundTransfer",
    "v": {
     "date": "31-3-2026",
     "from": "General Fund",
     "to": "Designated Fund - Emergency",
     "amount": "12345"
    }
   },
   {
    "op": "visit",
    "key": "report:mod:funds.statement"
   },
   {
    "op": "visit",
    "key": "report:funds"
   }

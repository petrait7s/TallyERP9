     "key": "report:mod:donors.register"
    }
   }
  ],
  "solution": [
   {
    "op": "row",
    "reg": "donors",
    "row": {
     "id": "D900",
     "name": "Test Donor",
     "type": "Individual"
    }
   },
   {
    "op": "master",
    "kind": "costCentre",
    "obj": {
     "name": "Donor: Test Donor",
     "category": "Donors"
    }
   },

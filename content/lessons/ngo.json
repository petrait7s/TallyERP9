  "level": "ngo",
  "company": "scdf",
  "title": {
   "en": "Fund accounting and inter-fund transfers",
   "bn": "ফান্ড অ্যাকাউন্টিং ও আন্তঃফান্ড স্থানান্তর"
  },
  "goal": {

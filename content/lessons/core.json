    },
    "check": {
     "t": "row",
     "reg": "stockMoves",
     "where": {
      "batch": "C3-B1"
     }
    }
   },
   {
    "instruction": {
     "en": "Add a reorder level of 120 for Blanket.",
     "bn": "Blanket-এর রিঅর্ডার লেভেল ১২০।"

    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "row",
     "reg": "reorder",
     "where": {
      "item": "Blanket",
      "level": "120"
     }
    }
   },
   {
    "instruction": {
     "en": "Add a Sales order SO-C3.",
     "bn": "সেলস অর্ডার SO-C3 যোগ।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "row",
     "reg": "orders",
     "where": {
      "id": "SO-C3"
     }
    }
   },
   {
    "instruction": {
     "en": "Open Batch-wise Stock.",
     "bn": "Batch-wise Stock খুলুন।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "visited",
     "key": "report:mod:inv.batches"
    }
   }
  ],
  "solution": [
   {
    "op": "row",
    "reg": "stockMoves",
    "row": {
     "date": "2026-03-01",
     "item": "Blanket",
     "godown": "Main Store",
     "qty": "50",
     "rate": "450.00",
     "batch": "C3-B1",
     "type": "Receipt"
    }
   },
   {
    "op": "row",
    "reg": "reorder",
    "row": {
     "item": "Blanket",
     "level": "120",
     "physical": ""
    }
   },
   {
    "op": "row",
    "reg": "orders",
    "row": {
     "id": "SO-C3",
     "type": "Sales",
     "party": "Upazila Health Complex",
     "item": "Blanket",
     "qty": "30",
     "pending": "30",
     "date": "2026-03-02"
    }
   },
   {
    "op": "visit",
    "key": "report:mod:inv.batches"
   }
  ],
  "covers": [
   "A4"
  ]
 },
 {
  "id": "C4",
  "level": "core",
  "company": "scdf",
  "title": {
   "en": "Banking: cheques and post-dated cheques",
   "bn": "ব্যাংকিং: চেক ও পোস্ট-ডেটেড চেক"
  },
  "goal": {
   "en": "Record cheque numbers and manage PDCs.",
   "bn": "চেক নম্বর ও পিডিসি ম্যানেজ করুন।"
  },
  "steps": [
   {
    "instruction": {
     "en": "F12: turn on \"Show cheque number\" and \"Allow post-dated vouchers\".",
     "bn": "F12: চেক নম্বর ও পোস্ট-ডেটেড অন করুন।"
    },
    "hint": {
     "en": "Try: F12",
     "bn": "চেষ্টা করুন: F12"
    },
    "keys": "F12",
    "check": {
     "t": "all",
     "checks": [
      {
       "t": "config",
       "key": "showChequeNo",
       "on": true
      },
      {
       "t": "config",
       "key": "allowPostDated",
       "on": true
      }
     ]
    }
   },
   {
    "instruction": {
     "en": "Payment with cheque C4-1001: Stationery 2,468 from Islami Bank A/c.",
     "bn": "চেক C4-1001 দিয়ে পেমেন্ট: Stationery ২,৪৬৮।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "voucher",
     "vtype": "Payment",
     "chequeNo": "C4-1001",
     "amount": 246800
    }
   },
   {
    "instruction": {
     "en": "Receipt post-dated cheque C4-PDC (Local Donations 9,999).",
     "bn": "পোস্ট-ডেটেড রিসিপ্ট C4-PDC (৯,৯৯৯)।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "voucher",
     "postDated": true,
     "chequeNo": "C4-PDC"
    }
   },
   {
    "instruction": {
     "en": "Open Cheque Register and Post-dated Cheques.",
     "bn": "Cheque Register ও Post-dated Cheques খুলুন।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "all",
     "checks": [
      {
       "t": "visited",
       "key": "report:mod:bank.cheques"
      },
      {
       "t": "visited",
       "key": "report:mod:bank.pdc"
      }
     ]
    }
   }
  ],
  "solution": [
   {
    "op": "config",
    "key": "showChequeNo",
    "on": true
   },
   {
    "op": "config",
    "key": "allowPostDated",
    "on": true
   },
   {
    "op": "voucher",
    "v": {
     "type": "Payment",
     "date": "2026-03-06",
     "entries": [
      {
       "ledger": "Stationery",
       "amount": 246800
      },
      {
       "ledger": "Islami Bank A/c",
       "amount": -246800
      }
     ],
     "chequeNo": "C4-1001"
    }
   },
   {
    "op": "voucher",
    "v": {
     "type": "Receipt",
     "date": "2026-03-27",
     "entries": [
      {
       "ledger": "Islami Bank A/c",
       "amount": 999900
      },
      {
       "ledger": "Local Donations",
       "amount": -999900
      }
     ],
     "postDated": true,
     "chequeNo": "C4-PDC"
    }
   },
   {
    "op": "visit",
    "key": "report:mod:bank.cheques"
   },
   {
    "op": "visit",
    "key": "report:mod:bank.pdc"
   }
  ],
  "covers": [
   "A5",
   "A3"
  ]

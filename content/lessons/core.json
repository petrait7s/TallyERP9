[
 {
  "id": "C1",
  "level": "core",
  "company": "scdf",
  "title": {
   "en": "Security: user roles and Tally Vault",
   "bn": "নিরাপত্তা: ইউজার রোল ও ভল্ট"
  },
  "goal": {
   "en": "Add a user, sign in as Auditor and protect the company.",
   "bn": "ইউজার যোগ করুন, অডিটর হিসেবে সাইন-ইন ও কোম্পানি সুরক্ষিত করুন।"
  },
  "steps": [
   {
    "instruction": {
     "en": "Add user \"auditor2\" (role Auditor) in Users & Roles.",
     "bn": "Users & Roles-এ \"auditor2\" (Auditor) যোগ করুন।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "row",
     "reg": "users",
     "where": {
      "name": "auditor2"
     }
    }
   },
   {
    "instruction": {
     "en": "Sign in as the Auditor (Select User).",
     "bn": "Select User দিয়ে অডিটর হিসেবে সাইন-ইন।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "user",
     "role": "Auditor"
    }
   },
   {
    "instruction": {
     "en": "Set a Tally Vault password for the company.",
     "bn": "কোম্পানির ভল্ট পাসওয়ার্ড দিন।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "vault"
    }
   }
  ],
  "quiz": [
   {
    "q": {
     "en": "Which role can only view?",
     "bn": "কোন রোল শুধু দেখতে পারে?"
    },
    "options": [
     "Auditor",
     "Admin",
     "Data Entry",
     "Owner"
    ],
    "answer": 0
   }
  ],
  "solution": [
   {
    "op": "row",
    "reg": "users",
    "row": {
     "name": "auditor2",
     "role": "Auditor",
     "password": "x"
    }
   },
   {
    "op": "user",
    "role": "Auditor",
    "name": "auditor2"
   },
   {
    "op": "vault",
    "pw": "learn"
   }
  ],
  "covers": [
   "A1",
   "B18"
  ]
 },
 {
  "id": "C2",
  "level": "core",
  "company": "scdf",
  "title": {
   "en": "Voucher types, classes and optional vouchers",
   "bn": "ভাউচার টাইপ, ক্লাস ও অপশনাল ভাউচার"
  },
  "goal": {
   "en": "Customise voucher types and use scenarios.",
   "bn": "ভাউচার টাইপ কাস্টমাইজ ও সিনারিও ব্যবহার।"
  },
  "steps": [
   {
    "instruction": {
     "en": "Create voucher type \"Zakat Receipt\" based on Receipt.",
     "bn": "\"Zakat Receipt\" ভাউচার টাইপ (Receipt-ভিত্তিক) তৈরি।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "master",
     "kind": "voucherType",
     "name": "Zakat Receipt",
     "where": {
      "kind": "Receipt"
     }
    }
   },
   {
    "instruction": {
     "en": "Add a voucher class for \"Zakat Receipt\".",
     "bn": "\"Zakat Receipt\"-এর ভাউচার ক্লাস যোগ।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "row",
     "reg": "voucherClasses",
     "where": {
      "type": "Zakat Receipt"
     }
    }
   },
   {
    "instruction": {
     "en": "Enter an OPTIONAL Payment: Training 5,555 from Islami Bank A/c.",
     "bn": "অপশনাল পেমেন্ট: Training ৫,৫৫৫।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "voucher",
     "vtype": "Payment",
     "amount": 555500,
     "optional": true
    }
   },
   {
    "instruction": {
     "en": "Open Scenario (optional vouchers).",
     "bn": "Scenario খুলুন।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"
    },
    "check": {
     "t": "visited",
     "key": "report:mod:audit.scenario"
    }
   }
  ],
  "solution": [
   {
    "op": "master",
    "kind": "voucherType",
    "obj": {
     "name": "Zakat Receipt",
     "kind": "Receipt"
    }
   },
   {
    "op": "row",
    "reg": "voucherClasses",
    "row": {
     "type": "Zakat Receipt",
     "class": "Zakat",
     "defaultLedger": "Local Donations"
    }
   },
   {
    "op": "voucher",
    "v": {
     "type": "Payment",
     "date": "2026-03-05",
     "entries": [
      {
       "ledger": "Training",
       "amount": 555500
      },
      {
       "ledger": "Islami Bank A/c",
       "amount": -555500
      }
     ],
     "optional": true
    }
   },
   {
    "op": "visit",
    "key": "report:mod:audit.scenario"
   }
  ],
  "covers": [
   "A2",
   "A3",
   "A7"
  ]
 },
 {
  "id": "C3",
  "level": "core",
  "company": "scdf",
  "title": {
   "en": "Advanced inventory: batches, reorder, orders",
   "bn": "অ্যাডভান্সড ইনভেন্টরি"
  },
  "goal": {
   "en": "Batches, reorder levels, physical stock and orders.",
   "bn": "ব্যাচ, রিঅর্ডার, ফিজিক্যাল স্টক ও অর্ডার।"
  },
  "steps": [
   {
    "instruction": {

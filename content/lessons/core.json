   },
   {
    "instruction": {
     "en": "Security & Data > Export Masters (XML).",
     "bn": "Export Masters (XML)।"
    },
    "hint": {
     "en": "Try: see the button bar",
     "bn": "চেষ্টা করুন: ডানদিকের বাটন দেখুন"

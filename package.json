{
  "name": "tallylearn-ngo",
  "productName": "TallyLearn NGO",
  "version": "1.0.0",
  "description": "TallyLearn NGO - Tally ERP 9 style practice simulator for NGO accounting (unaffiliated)",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "lint": "eslint src tests",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis portable --publish never",
    "e2e": "node tests/e2e/smoke.mjs",
    "seed": "vite-node scripts/gen-seed.ts && vite-node scripts/gen-lessons.ts && vite-node scripts/gen-bank.ts && vite-node scripts/gen-coverage-md.ts",
    "icons": "vite-node scripts/make-icons.ts",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "org.tallylearn.ngo",
    "productName": "TallyLearn NGO",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "content/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "TallyLearn-NGO-${version}-${target}.${ext}",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TallyLearn-NGO-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TallyLearn-NGO-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "artifactName": "TallyLearn-NGO-${version}.${ext}"
    }
  },
  "author": {
    "name": "TallyLearn NGO contributors",
    "email": "noreply@example.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/petrait7s/TallyERP9"
}
